{
  "schemaVersion": 1,
  "id": "terrain-diffusion-mc",
  "version": "${version}",
  "name": "Terrain Diffusion Continued",
  "description": "AI-diffusion terrain with survival worldgen: caves, aquifers, ore veins, and every vanilla and modded overworld biome. A maintained fork of Terrain Diffusion by xandergos.",
  "authors": [
    "xandergos"
  ],
  "contact": {
    "sources": "https://github.com/SambuddhaRoy/terrain-diffusion-mc",
    "issues": "https://github.com/SambuddhaRoy/terrain-diffusion-mc/issues",
    "homepage": "https://github.com/SambuddhaRoy/terrain-diffusion-mc"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcDataGenerator"
    ],
    "client": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcClient"
    ],
    "main": [
      "com.github.xandergos.terraindiffusionmc.TerrainDiffusionMc"
    ]
  },
  "mixins": [
    "terrain-diffusion-mc.mixins.json",
    {
      "config": "terrain-diffusion-mc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=25",
    "minecraft": "~${minecraft_version}"
  },
  "contributors": [
    "SambuddhaRoy"
  ],
  "suggests": {
    "terrablender": "*"
  }
}
